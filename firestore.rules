rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isFrontendTeam() {
      return isAuthenticated() && 
             request.auth.token.team == 'frontend-team-x';
    }
    
    function isValidTimestamp(timestamp) {
      return timestamp is timestamp;
    }
    
    // Rate limiting helper (basic)
    function notTooManyRequests() {
      // Firebase has built-in rate limiting, but we add an extra check
      return request.time > timestamp.date(2024, 1, 1);
    }
    
    // Default: Deny everything
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Read-only access for external teams with validation
    match /loneperiods/{period} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    match /activities/{activity} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    match /employees/{employee} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    match /assignments/{assignment} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    match /fellistor/{error} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    match /la_period_mappings/{mapping} {
      allow read: if isFrontendTeam() && notTooManyRequests();
      allow write: if false;
    }
    
    // Explicitly block sensitive collections
    match /admin/{document=**} {
      allow read, write: if false;
    }
    
    match /internal/{document=**} {
      allow read, write: if false;
    }
    
    match /credentials/{document=**} {
      allow read, write: if false;
    }
  }
}
